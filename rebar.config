{erl_opts, [debug_info, {parse_transform, lager_transform}]}.

%% Default-profile deps ship in every build, including releases.
%%
%% One dependency per profile (default/prod, dev, test) is deliberately pinned to
%% a release with a published advisory so the dependably vulnerability scanner has
%% a finding in each scope. See "Deliberately vulnerable dependencies" in README.md.
{deps, [
    {jiffy, "1.1.5"},
    {jsx, "3.1.0"},
    {lager, "3.9.2"},
    %% VULNERABLE ON PURPOSE (prod): every hackney 1.x carries several 2026
    %% advisories (e.g. CVE-2026-47071, SOCKS5 TLS upgrade ignores the caller
    %% timeout, HIGH), fixed only in hackney 4.x. Kept at 1.18.0 on purpose.
    {hackney, "1.18.0"}
]}.

%% Profile deps are only present when building `rebar3 as <profile> ...`; rebar3
%% activates `test` itself for eunit/ct. Note that rebar3 records only the default
%% profile in rebar.lock, so profile deps are pinned here by exact version instead.
{profiles, [
    {dev, [{deps, [
        {recon, "2.5.6"},
        %% VULNERABLE ON PURPOSE (dev): CVE-2026-21619 / GHSA-hx9w-f2w9-9g96,
        %% unsafe deserialization of Erlang terms, fixed in 0.12.1. A dev-shell
        %% tool for talking to Hex registries; nothing in src/ uses it.
        {hex_core, "0.11.0"}
    ]}]},
    {test, [{deps, [
        {meck, "1.2.0"},
        %% VULNERABLE ON PURPOSE (test): CVE-2026-8466 / GHSA-jfc2-q6qh-g5x8,
        %% unbounded buffer accumulation in multipart header parsing (HIGH),
        %% fixed in 2.15.0. Only serves the local HTTP test server in
        %% hello_world_http_tests; no multipart is ever parsed.
        {cowboy, "2.12.0"}
    ]}]}
]}.

{shell, [{apps, [hello_world]}]}.

%% All Hex packages come from the private dependably registry. `replace` drops the
%% built-in hex.pm entry so nothing falls back to the public registry. The name must
%% be exactly "dependably": the registry signs every resource under that name and
%% rebar3 verifies it on each fetch. The public key below is the org's signing key,
%% pinned here so a fetch is verified against a key committed with the code rather
%% than one downloaded at build time.
%%
%% No credential lives here. The token goes in rebar3's per-user auth file,
%% ~/.config/rebar3/hex.config, which rebar3 merges onto this entry by name:
%%   #{<<"dependably">> => #{repo_key => <<"<token>">>, api_key => <<"<token>">>}}.
%% CI writes that file from the shared REGISTRY_KEY variable (see .gitlab-ci.yml).
{hex, [{repos, replace, [
    #{name => <<"dependably">>,
      repo_url => <<"https://dependably.northwardlabs.ca/hex">>,
      api_url => <<"https://dependably.northwardlabs.ca/hex/api">>,
      repo_public_key => <<
        "-----BEGIN PUBLIC KEY-----\n"
        "MIICIjANBgkqhkiG9w0BAQEFAAOCAg8AMIICCgKCAgEAkpLcH5lnd5i+Met+d/Uk\n"
        "CMR26rld4HuWch6MNPSGRxNWUcoNH/ltwoooLGzG/mhiCb4xRnuL2ATbxdjSJJD+\n"
        "kw8zSKLqFvEwfvptq6Y0DfjLl5f/SAVOpfZ6Ntc6nKIZgrbz3CUQFXdRTxOPN30i\n"
        "5AwOocKzdol/Fh8McIvGVTUpHLXIc52oNjabFD4ViKMMvMKkkDz4h4vdemBUfQuv\n"
        "Khb2EkQCHwFP8eO6YhDjT5N4TQI+gWinB74QS5kp/wtQEkpYOB9Qk2QQ/KMGYYz6\n"
        "9XLzaDfrjvVjmqu8kyoj3oJQlmZRbsR/oZFzO5175KYf1UcXKdSDly2/ZCcA28IL\n"
        "wMtPhj+B+k0DUjuPQjwBvwPLW++0gZzLDa181Cn8m9rN8QsiaoA/LSwlAQTycI4s\n"
        "3JSYc7FqnG7QnA3d9cjavWc52wVgppatjq2COQpfK5fd8iUkzWX/blxEXF6/UQAz\n"
        "b0oC2KgzPy9ji94kI6rEY4X0/TU/wswWKYjbY4Q/GvqTRSitTrPUezxN2i/T0y55\n"
        "v4mLCJBtYzK+1aAvzbui8wdZW9krE3Uw5tujPZeoR9Xk7haFawqqCl5t0Q3rPL1B\n"
        "J008YfhhxzAbaHg1RDONCZmdnhp3hpXxIa1gplEaZJloIZmwDyBCj3UzaRyDHuvn\n"
        "SXYKBVSogD+SvyvZB3B51u8CAwEAAQ==\n"
        "-----END PUBLIC KEY-----\n"
      >>}
]}]}.
